  clothes: [0xe74c3c, 0x3498db, 0x2ecc71, 0xf39c12, 0x9b59b6, 0x1abc9c, 0xe67e22, 0x34495e, 0x95a5a6, 0xd35400],
  eyes: [0x2c3e50, 0x27ae60, 0x2980b9, 0x8e44ad, 0xd35400]
};

