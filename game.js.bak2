  { id: 'pocion_vida', name: 'Poción de vida', ingredients: ['hierba_roja', 'agua'], result: 'pocion_vida', category: 'alquimia', xp: 15 },
  { id: 'espada_hierro', name: 'Espada de hierro', ingredients: ['hierro', 'madera', 'cuero'], result: 'espada_hierro', category: 'herreria', xp: 50 },
  { id: 'hacha_piedra', name: 'Hacha de piedra', ingredients: ['piedra', 'madera'], result: 'hacha_piedra', category: 'carpinteria', xp: 20 },
