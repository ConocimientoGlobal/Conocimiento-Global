  cuero: { name: 'Cuero', type: 'material', icon: '🟫', stack: 99 },
  lana: { name: 'Lana', type: 'material', icon: '🧶', stack: 99 },
  hilo: { name: 'Hilo', type: 'material', icon: '🧵', stack: 99 },
  harina: { name: 'Harina', type: 'material', icon: '🌾', stack: 99 },
  agua: { name: 'Agua', type: 'material', icon: '💧', stack: 99 },
  hierba_roja: { name: 'Hierba roja', type: 'material', icon: '🌿', stack: 99 },
  verdura: { name: 'Verdura', type: 'material', icon: '🥕', stack: 99 },
