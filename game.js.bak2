  // Pociones
  pocion_vida: { name: 'Poción de vida', type: 'pocion', icon: '🧪', stack: 10, heal: 50 },
  // Ropa
  ropa_lana: { name: 'Ropa de lana', type: 'ropa', icon: '🧥', stack: 1, defense: 5 }
