// ============================================================
// ESTADO DEL JUEGO
// ============================================================

let gameState = {
  player: null,
  inventory: [],
  equipment: { top: null, bottom: null, shoes: null, weapon: null },
  stats: { level: 1, xp: 0, xpNext: 100, hp: 100, maxHp: 100, mp: 50, maxMp: 50, str: 5, int: 5, dex: 5, vit: 5 },
  skills: [],
  world: null,
  enemies: [],
  resources: [],
  buildings: [],
  discovered: { resources: [], enemies: [], recipes: [], buildings: [] },
  day: 1,
  time: 0
};

// ============================================================
// SISTEMA DE GUARDADO/CARGA
// ============================================================

function saveGame() {
  const saveData = {
    player: gameState.player,
    inventory: gameState.inventory,
    equipment: gameState.equipment,
    stats: gameState.stats,
    buildings: gameState.buildings.map(b => ({ type: b.type, x: b.x, y: b.y })),
    discovered: gameState.discovered,
    day: gameState.day,
    time: gameState.time,
    timestamp: new Date().toISOString()
  };
  try {
    localStorage.setItem('worldGameSave', JSON.stringify(saveData));
    console.log('Partida guardada:', new Date().toLocaleTimeString());
  } catch (e) {
    console.error('Error al guardar:', e);
  }
}

function loadGame() {
  try {
    const saved = localStorage.getItem('worldGameSave');
    if (saved) {
      const data = JSON.parse(saved);
      gameState.player = data.player;
      gameState.inventory = data.inventory || [];
      gameState.equipment = data.equipment || { top: null, bottom: null, shoes: null, weapon: null };
      gameState.stats = data.stats;
      gameState.day = data.day || 1;
      gameState.time = data.time || 0;
      gameState.discovered = data.discovered || { resources: [], enemies: [], recipes: [], buildings: [] };
      gameState.buildings = (data.buildings || []).map(b => ({ type: b.type, x: b.x, y: b.y }));
      console.log('Partida cargada:', data.timestamp);
      return true;
    }
  } catch (e) {
    console.error('Error al cargar:', e);
  }
  return false;
}

// ============================================================
// ESCENA: CREACIÓN DE PERSONAJE
// ============================================================

class CharacterCreationScene extends Phaser.Scene {
  constructor() { super({ key: 'CharacterCreation' }); }
  
  preload() {
    // Generar sprites proceduralmente
    this.createSprites();
  }
  
  createSprites() {
    // Crear texturas de personaje
    for (let i = 0; i < 20; i++) {
      const g = this.make.graphics({ x: 0, y: 0, add: false });
      // Cuerpo
      g.fillStyle(COLORS.skin[0]);
      g.fillRect(16, 20, 32, 40);
      // Cabeza
      g.fillStyle(COLORS.skin[0]);
      g.fillCircle(32, 12, 12);
      // Ojos
      g.fillStyle(0x000000);
      g.fillCircle(28, 10, 2);
      g.fillCircle(36, 10, 2);
      // Pelo (variaciones)
      g.fillStyle(COLORS.hair[i % COLORS.hair.length]);
      if (i < 4) { g.fillRect(20, 0, 24, 8); g.fillRect(20, 0, 8, 16); g.fillRect(36, 0, 8, 16); }
      else if (i < 8) { g.fillRect(20, 0, 24, 8); g.fillRect(16, 0, 8, 24); g.fillRect(40, 0, 8, 24); }
      else if (i < 12) { g.fillRect(20, 0, 24, 8); g.fillCircle(32, 4, 10); }
      else if (i < 16) { g.fillRect(20, 0, 24, 8); g.fillRect(20, 0, 4, 16); }
      else { g.fillRect(20, 0, 24, 8); g.fillRect(16, 0, 8, 12); g.fillRect(40, 0, 8, 12); }
      g.generateTexture('char_' + i, 64, 64);
      g.destroy();
    }
    
    // Crear texturas de ropa
    for (let i = 0; i < COLORS.clothes.length; i++) {
      const g = this.make.graphics({ x: 0, y: 0, add: false });
      g.fillStyle(COLORS.clothes[i]);
      g.fillRect(16, 20, 32, 40);
      g.generateTexture('shirt_' + i, 64, 64);
      g.destroy();
      
      const g2 = this.make.graphics({ x: 0, y: 0, add: false });
      g2.fillStyle(COLORS.clothes[i]);
      g2.fillRect(16, 40, 32, 20);
      g2.generateTexture('pants_' + i, 64, 64);
      g2.destroy();
    }
  }
  
  create() {
    this.add.text(CONFIG.width / 2, 50, 'Crear Personaje', { fontSize: '32px', color: '#fff' }).setOrigin(0.5);
    
    // Preview del personaje
    this.preview = this.add.image(CONFIG.width / 2, 250, 'char_0').setScale(3);
    
    // Nombre
    this.add.text(CONFIG.width / 2 - 200, 400, 'Nombre:', { fontSize: '18px', color: '#fff' });
    this.nameText = this.add.text(CONFIG.width / 2 - 50, 400, 'Hero', { fontSize: '18px', color: '#4ade80' });
    
    // Selector de piel
    this.add.text(CONFIG.width / 2 - 200, 440, 'Piel:', { fontSize: '14px', color: '#fff' });
    this.skinIndex = 0;
    COLORS.skin.forEach((c, i) => {
      const btn = this.add.rectangle(CONFIG.width / 2 - 50 + i * 40, 440, 30, 30, c).setInteractive();
      btn.on('pointerdown', () => { this.skinIndex = i; this.updatePreview(); });
    });
    
    // Selector de pelo
    this.add.text(CONFIG.width / 2 - 200, 480, 'Pelo:', { fontSize: '14px', color: '#fff' });
    this.hairIndex = 0;
    COLORS.hair.forEach((c, i) => {
      const btn = this.add.rectangle(CONFIG.width / 2 - 50 + i * 40, 480, 30, 30, c).setInteractive();
      btn.on('pointerdown', () => { this.hairIndex = i; this.updatePreview(); });
    });
    
    // Selector de ropa
    this.add.text(CONFIG.width / 2 - 200, 520, 'Ropa:', { fontSize: '14px', color: '#fff' });
    this.clothesIndex = 0;
    COLORS.clothes.forEach((c, i) => {
      const btn = this.add.rectangle(CONFIG.width / 2 - 50 + i * 40, 520, 30, 30, c).setInteractive();
      btn.on('pointerdown', () => { this.clothesIndex = i; this.updatePreview(); });
    });
    
    // Botón crear
    const createBtn = this.add.rectangle(CONFIG.width / 2, 620, 200, 50, 0x6366f1).setInteractive();
    createBtn.on('pointerdown', () => this.createCharacter());
    this.add.text(CONFIG.width / 2, 620, 'Crear', { fontSize: '20px', color: '#fff' }).setOrigin(0.5);
    
    this.updatePreview();
  }
  
  updatePreview() {
    this.preview.setTexture('char_' + (this.hairIndex * 4));
  }
  
  createCharacter() {
    gameState.player = {
      name: this.nameText.text || 'Hero',
      skinColor: COLORS.skin[this.skinIndex],
      hairColor: COLORS.hair[this.hairIndex],
      clothesColor: COLORS.clothes[this.clothesIndex],
      hairStyle: this.hairIndex,
      x: CONFIG.worldWidth * CONFIG.tileSize / 2,
      y: CONFIG.worldHeight * CONFIG.tileSize / 2
    };
    
    // Inventario inicial
    gameState.inventory = [
      { id: 'pan', qty: 5 },
      { id: 'agua', qty: 10 },
      { id: 'madera', qty: 20 }
    ];
    
    this.scene.start('WorldScene');
  }
}

// ============================================================
// ESCENA: MUNDO ABIERTO
// ============================================================

class WorldScene extends Phaser.Scene {
  constructor() { super({ key: 'WorldScene' }); }
  
  create() {
    // Crear mundo
    this.createWorld();
    
    // Crear jugador
    this.player = this.add.rectangle(gameState.player.x, gameState.player.y, 48, 48, gameState.player.clothesColor);
    this.player.setDepth(10);
    
    // Cámara
    this.cameras.main.setBounds(0, 0, CONFIG.worldWidth * CONFIG.tileSize, CONFIG.worldHeight * CONFIG.tileSize);
    this.cameras.main.startFollow(this.player);
    
    // Controles
    this.cursors = this.input.keyboard.createCursorKeys();
    this.wasd = this.input.keyboard.addKeys('W,A,S,D');
    this.space = this.input.keyboard.addKey('SPACE');
    this.iKey = this.input.keyboard.addKey('I');
    this.cKey = this.input.keyboard.addKey('C');
    this.bKey = this.input.keyboard.addKey('B');
    this.sKey = this.input.keyboard.addKey('S');
    this.lKey = this.input.keyboard.addKey('L');
    
    // UI
    this.createUI();
    
    // Spawn enemigos y recursos
    this.spawnEntities();
    
    // Guardar referencia
    gameState.scene = this;
    
    // Building mode
    this.buildingMode = false;
    this.selectedBuilding = null;
    this.buildingGhost = null;
    this.buildingMenu = null;
    
    // Auto-save cada 30 segundos
    this.time.addEvent({ delay: 30000, callback: () => saveGame(), loop: true });

    // Controles táctiles
    this.createTouchControls();

  }
  
  createWorld() {
    this.world = [];
    const tileSize = CONFIG.tileSize;
    
    // Generar mapa con biomas
    for (let y = 0; y < CONFIG.worldHeight; y++) {
      this.world[y] = [];
      for (let x = 0; x < CONFIG.worldWidth; x++) {
        const biome = this.getBiome(x, y);
        const tile = this.add.rectangle(x * tileSize, y * tileSize, tileSize, tileSize, biome.color);
        tile.setStrokeStyle(1, Phaser.Display.Color.IntegerToColor(biome.color).darken(20).color);
        this.world[y][x] = { biome, tile };
      }
    }
  }
  
  getBiome(x, y) {
    const noise = Math.sin(x * 0.1) * Math.cos(y * 0.1) + Math.sin(x * 0.05 + y * 0.05);
    if (noise > 0.5) return BIOMES[0]; // Bosque
    if (noise > 0) return BIOMES[1]; // Pradera
    if (noise > -0.5) return BIOMES[2]; // Montaña
    return BIOMES[3]; // Desierto
  }
  
  createUI() {
    // Barra de vida
    this.add.rectangle(10, 10, 200, 20, 0x333333).setOrigin(0, 0).setScrollFactor(0).setDepth(100);
    this.hpBar = this.add.rectangle(10, 10, 200, 20, 0xe74c3c).setOrigin(0, 0).setScrollFactor(0).setDepth(101);
    this.hpText = this.add.text(110, 20, '100/100', { fontSize: '12px', color: '#fff' }).setOrigin(0.5).setScrollFactor(0).setDepth(102);
    
    // Barra de XP
    this.add.rectangle(10, 35, 200, 10, 0x333333).setOrigin(0, 0).setScrollFactor(0).setDepth(100);
    this.xpBar = this.add.rectangle(10, 35, 0, 10, 0xf1c40f).setOrigin(0, 0).setScrollFactor(0).setDepth(101);
    this.xpText = this.add.text(110, 40, 'Nivel 1 - 0/100 XP', { fontSize: '10px', color: '#fff' }).setOrigin(0.5).setScrollFactor(0).setDepth(102);
    
    // Info del jugador
    this.add.text(10, 55, gameState.player.name, { fontSize: '14px', color: '#4ade80' }).setScrollFactor(0).setDepth(100);
    
    // Controles
    this.add.text(CONFIG.width - 10, 10, 'WASD: Mover | I: Inv | C: Craft | B: Construir | L: Biblioteca | S: Guardar | ESPACIO: Atacar', { fontSize: '10px', color: '#aaa' }).setOrigin(1, 0).setScrollFactor(0).setDepth(100);
  }
  
  spawnEntities() {
    // Spawn enemigos
    for (let i = 0; i < 30; i++) {
      const type = ENEMIES[Math.floor(Math.random() * ENEMIES.length)];
      const x = Math.random() * CONFIG.worldWidth * CONFIG.tileSize;
      const y = Math.random() * CONFIG.worldHeight * CONFIG.tileSize;
      const enemy = this.add.rectangle(x, y, 40, 40, type.color);
      enemy.setDepth(5);
      enemy.hp = type.hp;
      enemy.maxHp = type.hp;
      enemy.damage = type.damage;
      enemy.xp = type.xp;
      enemy.loot = type.loot;
      enemy.name = type.name;
      gameState.enemies.push(enemy);
    }
    
    // Spawn recursos
    for (let i = 0; i < 50; i++) {
      const x = Math.random() * CONFIG.worldWidth * CONFIG.tileSize;
      const y = Math.random() * CONFIG.worldHeight * CONFIG.tileSize;
      const biome = this.getBiome(Math.floor(x / CONFIG.tileSize), Math.floor(y / CONFIG.tileSize));
      const resource = biome.resources[Math.floor(Math.random() * biome.resources.length)];
      const res = this.add.rectangle(x, y, 30, 30, 0x8b4513);
      res.setDepth(4);
      res.resource = resource;
      gameState.resources.push(res);
    }
  }
  
  update() {
    const speed = 4;
    let moved = false;
    
    if (this.cursors.left.isDown || this.wasd.A.isDown) { this.player.x -= speed; moved = true; }
    if (this.cursors.right.isDown || this.wasd.D.isDown) { this.player.x += speed; moved = true; }
    if (this.cursors.up.isDown || this.wasd.W.isDown) { this.player.y -= speed; moved = true; }
    if (this.cursors.down.isDown || this.wasd.S.isDown) { this.player.y += speed; moved = true; }
    
    // Limites del mundo
    this.player.x = Phaser.Math.Clamp(this.player.x, 24, CONFIG.worldWidth * CONFIG.tileSize - 24);
    this.player.y = Phaser.Math.Clamp(this.player.y, 24, CONFIG.worldHeight * CONFIG.tileSize - 24);
    
    // Atacar
    if (Phaser.Input.Keyboard.JustDown(this.space)) {
      this.attack();
    }
    
    // Inventario
    if (Phaser.Input.Keyboard.JustDown(this.iKey)) {
      this.scene.pause();
      this.scene.launch('InventoryScene');
    }
    
    // Crafting
    if (Phaser.Input.Keyboard.JustDown(this.cKey)) {
      this.scene.pause();
      this.scene.launch('CraftingScene');
    }
    
    // Colisión con recursos
    this.collectResources();
    
    // Actualizar UI
    this.updateUI();
  }
  
  attack() {
    const attackRange = 60;
    gameState.enemies.forEach(enemy => {
      const dist = Phaser.Math.Distance.Between(this.player.x, this.player.y, enemy.x, enemy.y);
      if (dist < attackRange) {
        const damage = gameState.stats.str + (gameState.equipment.weapon ? ITEMS[gameState.equipment.weapon]?.damage || 0 : 0);
        enemy.hp -= damage;
        
        if (enemy.hp <= 0) {
          // Drop loot
          enemy.loot.forEach(item => {
            this.addToInventory(item, 1);
          });
          // Registrar descubrimiento de enemigo
          if (!gameState.discovered.enemies.includes(enemy.name)) {
            gameState.discovered.enemies.push(enemy.name);
          }
          gameState.stats.xp += enemy.xp;
          enemy.destroy();
          gameState.enemies = gameState.enemies.filter(e => e !== enemy);
          this.checkLevelUp();
        }
      }
    });
  }
  
  collectResources() {
    gameState.resources.forEach(res => {
      const dist = Phaser.Math.Distance.Between(this.player.x, this.player.y, res.x, res.y);
      if (dist < 40) {
        // Registrar descubrimiento de recurso
        if (!gameState.discovered.resources.includes(res.resource)) {
          gameState.discovered.resources.push(res.resource);
        }
        this.addToInventory(res.resource, 1);
        res.destroy();
        gameState.resources = gameState.resources.filter(r => r !== res);
        gameState.stats.xp += 2;
        this.checkLevelUp();
      }
    });
  }
  
  addToInventory(itemId, qty) {
    const existing = gameState.inventory.find(i => i.id === itemId);
    if (existing) {
      existing.qty += qty;
    } else {
      gameState.inventory.push({ id: itemId, qty });
    }
  }
  
  checkLevelUp() {
    while (gameState.stats.xp >= gameState.stats.xpNext) {
      gameState.stats.xp -= gameState.stats.xpNext;
      gameState.stats.level++;
      gameState.stats.xpNext = Math.floor(gameState.stats.xpNext * 1.5);
      gameState.stats.maxHp += 10;
      gameState.stats.hp = gameState.stats.maxHp;
      gameState.stats.str += 1;
      gameState.stats.int += 1;
      gameState.stats.dex += 1;
      gameState.stats.vit += 1;
    }
  }
  
  updateUI() {
    const hpPercent = gameState.stats.hp / gameState.stats.maxHp;
    this.hpBar.width = 200 * hpPercent;
    this.hpText.setText(gameState.stats.hp + '/' + gameState.stats.maxHp);
    
    const xpPercent = gameState.stats.xp / gameState.stats.xpNext;
    this.xpBar.width = 200 * xpPercent;
    this.xpText.setText('Nivel ' + gameState.stats.level + ' - ' + gameState.stats.xp + '/' + gameState.stats.xpNext + ' XP');
  }

  showBuildingMenu() {
    this.buildingMenu = this.add.container(0, 0).setScrollFactor(0).setDepth(200);
    const bg = this.add.rectangle(CONFIG.width / 2, CONFIG.height / 2, 500, 350, 0x1a1a2e, 0.95).setStrokeStyle(2, 0x6366f1);
    const title = this.add.text(CONFIG.width / 2, 70, '🏗️ CONSTRUIR', { fontSize: '24px', color: '#fff' }).setOrigin(0.5);
    this.buildingMenu.add([bg, title]);
    
    BUILDINGS.forEach((b, i) => {
      const x = CONFIG.width / 2 - 200 + (i % 3) * 200;
      const y = 140 + Math.floor(i / 3) * 90;
      const btn = this.add.rectangle(x, y, 180, 70, 0x2d2d44).setStrokeStyle(1, 0x6366f1).setInteractive();
      btn.on('pointerdown', () => this.selectBuilding(b.id));
      this.buildingMenu.add(btn);
      this.buildingMenu.add(this.add.text(x, y - 15, b.icon + ' ' + b.name, { fontSize: '12px', color: '#fff' }).setOrigin(0.5));
      this.buildingMenu.add(this.add.text(x, y + 15, Object.entries(b.cost).map(([k,v]) => v + ' ' + k).join(', '), { fontSize: '9px', color: '#aaa' }).setOrigin(0.5));
    });
    
    const closeBtn = this.add.rectangle(CONFIG.width / 2, 330, 120, 35, 0xe74c3c).setInteractive();
    closeBtn.on('pointerdown', () => { this.buildingMode = false; this.hideBuildingMenu(); });
    this.buildingMenu.add(closeBtn);
    this.buildingMenu.add(this.add.text(CONFIG.width / 2, 330, 'Cancelar (B)', { fontSize: '12px', color: '#fff' }).setOrigin(0.5));
  }
  
  hideBuildingMenu() {
    if (this.buildingMenu) { this.buildingMenu.destroy(); this.buildingMenu = null; }
    this.selectedBuilding = null;
    if (this.buildingGhost) { this.buildingGhost.destroy(); this.buildingGhost = null; }
  }
  
  selectBuilding(buildingId) {
    this.selectedBuilding = BUILDINGS.find(b => b.id === buildingId);
    this.hideBuildingMenu();
    if (this.buildingGhost) this.buildingGhost.destroy();
    this.buildingGhost = this.add.rectangle(0, 0, 80, 80, 0x6366f1, 0.5).setDepth(50);
  }
  
  placeBuilding(x, y) {
    Object.entries(this.selectedBuilding.cost).forEach(([item, qty]) => {
      const inv = gameState.inventory.find(i => i.id === item);
      if (inv) {
        inv.qty -= qty;
        if (inv.qty <= 0) gameState.inventory = gameState.inventory.filter(i => i.id !== item);
      }
    });
    
    const building = this.add.rectangle(x, y, 80, 80, 0x8b6914).setDepth(3);
    building.type = this.selectedBuilding.id;
    building.name = this.selectedBuilding.name;
    gameState.buildings.push(building);
    
    if (!gameState.discovered.buildings.includes(this.selectedBuilding.id)) {
      gameState.discovered.buildings.push(this.selectedBuilding.id);
      gameState.stats.xp += 10;
    }
    
    this.selectedBuilding = null;
    if (this.buildingGhost) { this.buildingGhost.destroy(); this.buildingGhost = null; }
  }

}

// ============================================================
// ESCENA: BIBLIOTECA DE CONOCIMIENTO
// ============================================================

class LibraryScene extends Phaser.Scene {
  constructor() { super({ key: 'LibraryScene' }); }
  
  create() {
    this.add.rectangle(CONFIG.width / 2, CONFIG.height / 2, CONFIG.width, CONFIG.height, 0x000000, 0.85);
    this.add.rectangle(CONFIG.width / 2, CONFIG.height / 2, 800, 550, 0x1a1a2e).setStrokeStyle(2, 0x6366f1);
    this.add.text(CONFIG.width / 2, 50, '📚 BIBLIOTECA DE CONOCIMIENTO', { fontSize: '28px', color: '#fff' }).setOrigin(0.5);
    
    const discovered = gameState.discovered;
    let yPos = 100;
    
    const categories = [
      { key: 'resources', name: '🌿 Recursos Descubiertos' },
      { key: 'enemies', name: '🐺 Enemigos Encontrados' },
      { key: 'recipes', name: '📜 Recetas Aprendidas' },
      { key: 'buildings', name: '🏗️ Construcciones' }
    ];
    
    categories.forEach((cat, i) => {
      const x = 100 + (i % 2) * 400;
      const y = yPos + Math.floor(i / 2) * 150;
      this.add.text(x, y, cat.name, { fontSize: '16px', color: '#4ade80' }).setOrigin(0, 0);
      
      const items = discovered[cat.key] || [];
      if (items.length === 0) {
        this.add.text(x, y + 30, 'Nada aún...', { fontSize: '12px', color: '#666' }).setOrigin(0, 0);
      } else {
        items.forEach((item, j) => {
          this.add.text(x, y + 30 + j * 22, '✓ ' + item, { fontSize: '12px', color: '#fff' }).setOrigin(0, 0);
        });
      }
    });
    
    const closeBtn = this.add.rectangle(CONFIG.width / 2, 520, 150, 40, 0xe74c3c).setInteractive();
    closeBtn.on('pointerdown', () => { this.scene.stop(); this.scene.resume('WorldScene'); });
    this.add.text(CONFIG.width / 2, 520, 'Cerrar (L)', { fontSize: '14px', color: '#fff' }).setOrigin(0.5);
    
    this.input.keyboard.on('keydown-L', () => { this.scene.stop(); this.scene.resume('WorldScene'); });
  }
}

// ============================================================
// ESCENA: INVENTARIO
// ============================================================

class InventoryScene extends Phaser.Scene {
  constructor() { super({ key: 'InventoryScene' }); }
  
  create() {
    // Fondo oscuro
    this.add.rectangle(CONFIG.width / 2, CONFIG.height / 2, CONFIG.width, CONFIG.height, 0x000000, 0.8);
    
    // Panel de inventario
    this.add.rectangle(CONFIG.width / 2, CONFIG.height / 2, 600, 500, 0x1a1a2e).setStrokeStyle(2, 0x6366f1);
    this.add.text(CONFIG.width / 2, 80, '🎒 INVENTARIO', { fontSize: '24px', color: '#fff' }).setOrigin(0.5);
    
    // Mostrar items
    const startX = CONFIG.width / 2 - 250;
    const startY = 130;
    const cols = 6;
    
    gameState.inventory.forEach((item, i) => {
      const x = startX + (i % cols) * 80;
      const y = startY + Math.floor(i / cols) * 70;
      
      const itemData = ITEMS[item.id];
      if (!itemData) return;
      
      this.add.rectangle(x, y, 70, 60, 0x2d2d44).setStrokeStyle(1, 0x6366f1);
      this.add.text(x, y - 10, itemData.icon, { fontSize: '20px' }).setOrigin(0.5);
      this.add.text(x, y + 15, itemData.name + ' x' + item.qty, { fontSize: '9px', color: '#aaa' }).setOrigin(0.5);
    });
    
    // Stats
    this.add.text(CONFIG.width / 2, 440, `Nivel: ${gameState.stats.level} | HP: ${gameState.stats.hp}/${gameState.stats.maxHp} | STR: ${gameState.stats.str} | INT: ${gameState.stats.int} | DEX: ${gameState.stats.dex} | VIT: ${gameState.stats.vit}`, { fontSize: '12px', color: '#4ade80' }).setOrigin(0.5);
    
    // Cerrar
    const closeBtn = this.add.rectangle(CONFIG.width / 2, 480, 150, 40, 0xe74c3c).setInteractive();
    closeBtn.on('pointerdown', () => { this.scene.stop(); this.scene.resume('WorldScene'); });
    this.add.text(CONFIG.width / 2, 480, 'Cerrar (I)', { fontSize: '14px', color: '#fff' }).setOrigin(0.5);
    
    // Cerrar con tecla
    this.input.keyboard.on('keydown-I', () => { this.scene.stop(); this.scene.resume('WorldScene'); });
  }
}

// ============================================================
// ESCENA: CRAFTING
// ============================================================

class CraftingScene extends Phaser.Scene {
  constructor() { super({ key: 'CraftingScene' }); }
  
  create() {
    this.add.rectangle(CONFIG.width / 2, CONFIG.height / 2, CONFIG.width, CONFIG.height, 0x000000, 0.8);
    this.add.rectangle(CONFIG.width / 2, CONFIG.height / 2, 700, 550, 0x1a1a2e).setStrokeStyle(2, 0x6366f1);
    this.add.text(CONFIG.width / 2, 60, '🔨 CRAFTING', { fontSize: '24px', color: '#fff' }).setOrigin(0.5);
    
    // Categorías
    const categories = ['cocina', 'herreria', 'carpinteria', 'alquimia', 'sastreria'];
    const catNames = { cocina: '🍳 Cocina', herreria: '⚔️ Herrería', carpinteria: '🪓 Carpintería', alquimia: '🧪 Alquimia', sastreria: '🧵 Sastrería' };
    
    categories.forEach((cat, i) => {
      const btn = this.add.rectangle(150 + i * 120, 100, 100, 35, 0x2d2d44).setStrokeStyle(1, 0x6366f1).setInteractive();
      btn.on('pointerdown', () => this.showCategory(cat));
      this.add.text(150 + i * 120, 100, catNames[cat], { fontSize: '10px', color: '#fff' }).setOrigin(0.5);
    });
    
    this.recipeContainer = this.add.container(0, 0);
    this.showCategory('cocina');
    
    // Cerrar
    const closeBtn = this.add.rectangle(CONFIG.width / 2, 520, 150, 40, 0xe74c3c).setInteractive();
    closeBtn.on('pointerdown', () => { this.scene.stop(); this.scene.resume('WorldScene'); });
    this.add.text(CONFIG.width / 2, 520, 'Cerrar (C)', { fontSize: '14px', color: '#fff' }).setOrigin(0.5);
    
    this.input.keyboard.on('keydown-C', () => { this.scene.stop(); this.scene.resume('WorldScene'); });
  }
  
  showCategory(category) {
    this.recipeContainer.removeAll(true);
    
    const recipes = RECIPES.filter(r => r.category === category);
    recipes.forEach((recipe, i) => {
      const x = 150 + (i % 4) * 160;
      const y = 180 + Math.floor(i / 4) * 100;
      
      const canCraft = recipe.ingredients.every(ing => {
        const item = gameState.inventory.find(it => it.id === ing);
        return item && item.qty >= 1;
      });
      
      const bg = this.add.rectangle(x, y, 140, 80, canCraft ? 0x2d5a27 : 0x5a2d2d).setStrokeStyle(1, 0x6366f1).setInteractive();
      bg.on('pointerdown', () => this.craft(recipe));
      
      this.recipeContainer.add(bg);
      this.recipeContainer.add(this.add.text(x, y - 20, recipe.name, { fontSize: '11px', color: '#fff' }).setOrigin(0.5));
      this.recipeContainer.add(this.add.text(x, y + 5, recipe.ingredients.join(', '), { fontSize: '8px', color: '#aaa' }).setOrigin(0.5));
      this.recipeContainer.add(this.add.text(x, y + 25, canCraft ? '✅ Disponible' : '❌ Faltan', { fontSize: '9px', color: canCraft ? '#4ade80' : '#f87171' }).setOrigin(0.5));
    });
  }
  
  craft(recipe) {
    // Verificar ingredientes
    const canCraft = recipe.ingredients.every(ing => {
      const item = gameState.inventory.find(it => it.id === ing);
      return item && item.qty >= 1;
    });
    
    if (!canCraft) return;
    
    // Consumir ingredientes
    recipe.ingredients.forEach(ing => {
      const item = gameState.inventory.find(it => it.id === ing);
      if (item) {
        item.qty--;
        if (item.qty <= 0) {
          gameState.inventory = gameState.inventory.filter(i => i.id !== ing);
        }
      }
    });
    
    // Dar resultado
    const existing = gameState.inventory.find(i => i.id === recipe.result);
    if (existing) {
      existing.qty++;
    } else {
      gameState.inventory.push({ id: recipe.result, qty: 1 });
    }
    
    gameState.stats.xp += recipe.xp;
    // Registrar descubrimiento de receta
    if (!gameState.discovered.recipes.includes(recipe.name)) {
      gameState.discovered.recipes.push(recipe.name);
    }
    this.showCategory(recipe.category);
  }
}

// ============================================================
// CONFIGURACIÓN DEL JUEGO
// ============================================================

const config = {
  type: Phaser.AUTO,
  width: CONFIG.width,
  height: CONFIG.height,
  parent: 'game-container',
  backgroundColor: '#1a1a2e',
  physics: { default: 'arcade', arcade: { debug: false } },
  scene: [CharacterCreationScene, WorldScene, InventoryScene, CraftingScene, LibraryScene]

  createTouchControls() {
    const screenW = CONFIG.width;
    const screenH = CONFIG.height;
    
    // Joystick zona izquierda
    this.joyX = 100;
    this.joyY = screenH - 100;
    this.joyRadius = 60;
    this.joyKnob = null;
    this.joyActive = false;
    this.joyTouchId = null;
    
    // Dibujo del joystick
    this.joyBase = this.add.circle(this.joyX, this.joyY, this.joyRadius, 0x333333, 0.5).setScrollFactor(0).setDepth(200);
    this.joyKnob = this.add.circle(this.joyX, this.joyY, 25, 0x6366f1, 0.8).setScrollFactor(0).setDepth(201);
    
    // Botones de acción (derecha)
    this.buttons = [];
    const btnRadius = 30;
    const btnY = screenH - 100;
    const btnSpacing = 70;
    
    const actions = [
      { key: 'attack', label: '⚔️', x: screenW - 250, color: 0xe74c3c },
      { key: 'inventory', label: '🎒', x: screenW - 170, color: 0x3498db },
      { key: 'craft', label: '🔨', x: screenW - 90, color: 0xf39c12 },
      { key: 'build', label: '🏗️', x: screenW - 210, y: btnY - 80, color: 0x2ecc71 },
      { key: 'library', label: '📚', x: screenW - 130, y: btnY - 80, color: 0x9b59b6 }
    ];
    
    actions.forEach(a => {
      const btn = this.add.circle(a.x, a.y || btnY, btnRadius, a.color, 0.7)
        .setScrollFactor(0).setDepth(200).setInteractive();
      const txt = this.add.text(a.x, a.y || btnY, a.label, { fontSize: '20px' })
        .setOrigin(0.5).setScrollFactor(0).setDepth(201);
      this.buttons.push({ btn, txt, key: a.key });
    });
    
    // Eventos táctiles
    this.input.on('pointerdown', (pointer) => {
      // Verificar si tocó un botón
      for (const b of this.buttons) {
        const dist = Phaser.Math.Distance.Between(pointer.x, pointer.y, b.btn.x, b.btn.y);
        if (dist < btnRadius) {
          this.handleTouchAction(b.key);
          return;
        }
      }
      
      // Si tocó la zona izquierda, activar joystick
      if (pointer.x < screenW / 2) {
        this.joyActive = true;
        this.joyTouchId = pointer.id;
        this.joyX = pointer.x;
        this.joyY = pointer.y;
        this.joyBase.setPosition(this.joyX, this.joyY);
        this.joyKnob.setPosition(this.joyX, this.joyY);
      }
    });
    
    this.input.on('pointermove', (pointer) => {
      if (!this.joyActive || pointer.id !== this.joyTouchId) return;
      
      const dist = Phaser.Math.Distance.Between(this.joyX, this.joyY, pointer.x, pointer.y);
      const angle = Math.atan2(pointer.y - this.joyY, pointer.x - this.joyX);
      
      if (dist <= this.joyRadius) {
        this.joyKnob.setPosition(pointer.x, pointer.y);
      } else {
        this.joyKnob.setPosition(
          this.joyX + Math.cos(angle) * this.joyRadius,
          this.joyY + Math.sin(angle) * this.joyRadius
        );
      }
      
      // Mover jugador según joystick
      const speed = 4;
      const dx = (this.joyKnob.x - this.joyX) / this.joyRadius;
      const dy = (this.joyKnob.y - this.joyY) / this.joyRadius;
      this.player.x += dx * speed;
      this.player.y += dy * speed;
    });
    
    this.input.on('pointerup', (pointer) => {
      if (pointer.id === this.joyTouchId) {
        this.joyActive = false;
        this.joyTouchId = null;
        this.joyKnob.setPosition(this.joyX, this.joyY);
      }
    });
  }
  
  handleTouchAction(key) {
    switch(key) {
      case 'attack':
        this.attack();
        break;
      case 'inventory':
        this.scene.pause();
        this.scene.launch('InventoryScene');
        break;
      case 'craft':
        this.scene.pause();
        this.scene.launch('CraftingScene');
        break;
      case 'build':
        this.buildingMode = !this.buildingMode;
        if (this.buildingMode) {
          this.showBuildingMenu();
        } else {
          this.hideBuildingMenu();
        }
        break;
      case 'library':
        this.scene.pause();
        this.scene.launch('LibraryScene');
        break;
    }
  }
};

const game = new Phaser.Game(config);
